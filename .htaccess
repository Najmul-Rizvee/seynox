RewriteEngine On

# Single-file site with a client-side hash router (index.html handles
# everything after the #). Serve index.html for any request that isn't
# an actual file/directory on disk, so old bookmarked/indexed URLs like
# /managed-it still load the app (index.html's own redirect map then
# sends them to the matching #/... route instead of just landing on
# the homepage) rather than 404ing.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
